{
  "name": "utix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "registry": "node scripts/generate-registry.mjs",
    "predev": "npm run registry",
    "dev": "node api.js && next dev",
    "prebuild": "npm run registry",
    "build": "node api.js && next build",
    "postbuild": "node scripts/bundle-budget.mjs",
    "start": "node api.js && next start",
    "prelint": "npm run registry",
    "lint": "eslint .",
    "pretest": "npm run registry",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test tests/e2e/critical-journey.spec.ts",
    "test:watch": "vitest",
    "test:workers": "vitest run core/workers",
    "test:coverage": "vitest run --coverage",
    "verify:telemetry": "node scripts/verify-telemetry.mjs",
    "verify:reconciliation": "node scripts/verify-reconciliation.mjs",
    "verify:audit": "node scripts/verify-audit.mjs",
    "verify:ledger": "node scripts/verify-ledger.mjs",
    "verify:features": "node scripts/verify-features.mjs",
    "verify:registry": "node scripts/check-registry-budget.mjs",
    "verify:boundaries": "node scripts/check-feature-boundaries.mjs",
    "verify:issues": "node scripts/validate-issue-catalog.mjs",
    "verify:contract": "vitest run core/contract",
    "verify:replay": "vitest run core/replay",
    "new:feature": "node scripts/new-feature.mjs",
    "postinstall": "node scripts/generate-registry.mjs",
    "verify:fixtures": "vitest run core/testing/__tests__/fixtures.contract.test.ts --reporter=verbose",
    "verify:readiness": "node scripts/release-readiness-gate.mjs",
    "check": "npm run lint && npm run test && npm run verify:features && npm run verify:boundaries && npm run verify:issues && npm run verify:telemetry && npm run verify:reconciliation && npm run verify:audit && npm run verify:ledger && npm run verify:readiness && npm run verify:fixtures && npm run build",
    "issues": "node scripts/create-issues.mjs",
    "issues:drips": "node scripts/create-issues.mjs --target drips",
    "recovery:validate": "node scripts/validate-recovery.mjs",
    "health:check": "node scripts/health-check.mjs",
    "bundle:check": "node scripts/bundle-budget.mjs",
    "diagnostics:contributor": "node --loader ./scripts/loader.mjs scripts/contributor-diagnostics.mjs",
    "doctor": "node --loader ./scripts/loader.mjs scripts/contributor-diagnostics.mjs",
    "verify:issues-264-275": "node --loader ./scripts/loader.mjs scripts/verify-issues-264-275.mjs"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^13.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.2.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20.17.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@playwright/test": "^1.62.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3"
  },
  "overrides": {
    "postcss": "^8.5.19"
  }
}
